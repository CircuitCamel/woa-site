# Environment the app is running in: development, staging, production
ENV=production

# Path to SSL certificate file
CRT=/etc/ssl/certs/server.crt

# Path to SSL private key file
KEY=/etc/ssl/private/server.key

# Port the application will listen on
PORT=1234

# path to links file
LINKS=content/links.md

# Path to the SQLite database for accounts and character sheets
DB_PATH=./data/warofages.db

# First admin account, created only when the database has no admin yet.
# If ADMIN_PASSWORD is blank, a random one is printed once to the console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
